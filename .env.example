# Copy this file to `.env` (gitignored) and fill in your values.
# NEVER commit the real .env to GitHub.

# ── Gemini TTS voice-narration generation (LOCAL only — the deployed site
#    never calls any API; it plays committed audio from public/audio/) ──
# Get a key: https://aistudio.google.com/api-keys
GOOGLE_API_KEY="MY_GEMINI_API_KEY"

# Optional voice overrides for casting/re-casting (names or voice library IDs).
# Leave unset to use the locked choices in src/lib/voiceConfig.ts.
GOOGLE_VOICE_EN=""
GOOGLE_VOICE_AF=""
