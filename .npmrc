# Vite 8 (peerOptional esbuild ^0.27||^0.28) conflicts with the AI Studio
# template's root devDep esbuild ^0.25.0, so plain `npm install` fails with
# ERESOLVE (locally and on Vercel: "[BUILD_UTILS_SPAWN_1] npm install exited 1").
# Legacy resolution (as before peer deps became strict) accepts both. Remove
# this file if the root esbuild dep is upgraded to ^0.28.
legacy-peer-deps=true
